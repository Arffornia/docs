        <mxCell id="legend-edge-async" value="" style="edgeStyle=none;html=1;strokeColor=#a78bfa;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=6;dashed=1;dashPattern=6 4;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="350" y="1379" as="sourcePoint" />
