          </mxGeometry>
        </mxCell>
        <mxCell id="legend-edge-async-text" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;background sync&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=10.5;fontColor=#e2e8f0;" vertex="1" parent="1">
          <mxGeometry x="402" y="1368" width="228" height="22" as="geometry" />
        </mxCell>
        <mxCell id="legend-edge-link" value="" style="edgeStyle=none;html=1;strokeColor=#64748b;strokeWidth=1.2;endArrow=open;endFill=0;endSize=6;dashed=1;dashPattern=2 3;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="350" y="1405" as="sourcePoint" />
            <mxPoint x="390" y="1405" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="legend-edge-link-text" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;object reference, not traffic&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=10.5;fontColor=#e2e8f0;" vertex="1" parent="1">
          <mxGeometry x="402" y="1394" width="228" height="22" as="geometry" />
        </mxCell>
        <mxCell id="card-legend-notes" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;Large dashed frame: infra perimeter · small: functional group&lt;br&gt;&lt;font color=&quot;#fb923c&quot;&gt;&lt;b&gt;⚠ Gx&lt;/b&gt;&lt;/font&gt;: docs and code disagree, see &quot;Gaps&quot;&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=10.5;fontColor=#94a3b8;" vertex="1" parent="1">
          <mxGeometry x="60" y="1550" width="560" height="40" as="geometry" />
        </mxCell>
        <mxCell id="card-data-plane" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;&lt;font color=&quot;#22d3ee&quot;&gt;●&lt;/font&gt;&amp;nbsp;&lt;b&gt;&lt;font color=&quot;#f8fafc&quot; style=&quot;font-size:13px&quot;&gt;Request path · to the server&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;div style=&quot;line-height:1.6&quot;&gt;&lt;span style=&quot;background-color:#f8fafc;color:#020617;border-radius:3px;padding:0px 4px;font-weight:bold;&quot;&gt;1&lt;/span&gt; A maintainer pushes to main of Arffornia_Provisioning: modList.json (CurseForge, Modrinth, GitHub entries) and storage/ files.&lt;br&gt;&lt;span style=&quot;background-color:#f8fafc;color:#020617;border-radius:3px;padding:0px 4px;font-weight:bold;&quot;&gt;2&lt;/span&gt; The index bot regenerates index.json (path, sha1) for server, proxy and launcher, and commits it.&lt;br&gt;&lt;span style=&quot;background-color:#f8fafc;color:#020617;border-radius:3px;padding:0px 4px;font-weight:bold;&quot;&gt;3&lt;/span&gt; At pod start, the config-updater init container reads modList.json, index.json and storage/ from raw.githubusercontent.com (BASE_URL).&lt;br&gt;&lt;span style=&quot;background-color:#f8fafc;color:#020617;border-radius:3px;padding:0px 4px;font-weight:bold;&quot;&gt;4&lt;/span&gt; Nexus_Mods resolves each entry on api.curse.tools (and Modrinth, GitHub releases), then downloads missing or changed jars.&lt;br&gt;&lt;span style=&quot;background-color:#f8fafc;color:#020617;border-radius:3px;padding:0px 4px;font-weight:bold;&quot;&gt;5&lt;/span&gt; It writes /data: mods/, config/, kubejs/… and deletes every jar not in the list.&lt;br&gt;&lt;span style=&quot;background-color:#f8fafc;color:#020617;border-radius:3px;padding:0px 4px;font-weight:bold;&quot;&gt;6&lt;/span&gt; The itzg server boots NeoForge 21.1.172 from /data, replacing ${CFG_*} placeholders with Secret values.&lt;/div&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#0b1222;strokeColor=#1e293b;align=left;verticalAlign=top;spacingLeft=20;spacingTop=14;spacingRight=16;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=11;fontColor=#e2e8f0;" vertex="1" parent="1">
          <mxGeometry x="670" y="1290" width="900" height="310" as="geometry" />
        </mxCell>
        <mxCell id="card-control-plane" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;&lt;font color=&quot;#a78bfa&quot;&gt;●&lt;/font&gt;&amp;nbsp;&lt;b&gt;&lt;font color=&quot;#f8fafc&quot; style=&quot;font-size:13px&quot;&gt;Background and player side&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;div style=&quot;line-height:1.6&quot;&gt;&lt;span style=&quot;border:1px solid #f8fafc;color:#f8fafc;border-radius:3px;padding:0px 3px;font-weight:bold;&quot;&gt;A&lt;/span&gt; Mods and Proxy publish arffornia.jar and arffornia_proxy.jar on tags v*; modLists pin them to tag latest.&lt;br&gt;&lt;span style=&quot;border:1px solid #f8fafc;color:#f8fafc;border-radius:3px;padding:0px 3px;font-weight:bold;&quot;&gt;B&lt;/span&gt; build_app.yml pushes config-updater only on tags updater-* (only updater-0.0.7 exists); the dotted link is the init container pulling :latest.&lt;br&gt;&lt;span style=&quot;border:1px solid #f8fafc;color:#f8fafc;border-radius:3px;padding:0px 3px;font-weight:bold;&quot;&gt;C&lt;/span&gt; electron-updater checks GitHub releases of the launcher.&lt;br&gt;• On Play the launcher installs Java 21 from Azul and the NeoForge installer, syncs the launcher mod list into the game directory, then MCLC fetches Mojang files.&lt;/div&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#0b1222;strokeColor=#1e293b;align=left;verticalAlign=top;spacingLeft=20;spacingTop=14;spacingRight=16;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=11;fontColor=#e2e8f0;" vertex="1" parent="1">
          <mxGeometry x="1600" y="1290" width="700" height="310" as="geometry" />
        </mxCell>
        <mxCell id="card-gaps" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;&lt;font color=&quot;#fb923c&quot;&gt;●&lt;/font&gt;&amp;nbsp;&lt;b&gt;&lt;font color=&quot;#f8fafc&quot; style=&quot;font-size:13px&quot;&gt;Gaps and risks found in code&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;div style=&quot;line-height:1.6&quot;&gt;&lt;b&gt;&lt;font color=&quot;#fb923c&quot;&gt;G7&lt;/font&gt;&lt;/b&gt; &lt;b&gt;&lt;font color=&quot;#f8fafc&quot;&gt;Old repo URL.&lt;/font&gt;&lt;/b&gt; BASE_URL and JSON_MOD_LIST_URL use Arffornia_Network, alive only through GitHub&amp;#39;s redirect.&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#fb923c&quot;&gt;G8&lt;/font&gt;&lt;/b&gt; &lt;b&gt;&lt;font color=&quot;#f8fafc&quot;&gt;Failed lookups delete mods.&lt;/font&gt;&lt;/b&gt; Errors are logged, unresolved jars are deleted, exit code 0.&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#fb923c&quot;&gt;G9&lt;/font&gt;&lt;/b&gt; &lt;b&gt;&lt;font color=&quot;#f8fafc&quot;&gt;No versioning.&lt;/font&gt;&lt;/b&gt; main is production for everyone; jars on tag latest; images on :latest.&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#fb923c&quot;&gt;G10&lt;/font&gt;&lt;/b&gt; &lt;b&gt;&lt;font color=&quot;#f8fafc&quot;&gt;Third-party proxy.&lt;/font&gt;&lt;/b&gt; CurseForge metadata from api.curse.tools, not the official API.&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#fb923c&quot;&gt;G11&lt;/font&gt;&lt;/b&gt; &lt;b&gt;&lt;font color=&quot;#f8fafc&quot;&gt;Unverified downloads.&lt;/font&gt;&lt;/b&gt; Java and NeoForge installer have no checksum.&lt;/div&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#0b1222;strokeColor=#1e293b;align=left;verticalAlign=top;spacingLeft=20;spacingTop=14;spacingRight=16;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=11;fontColor=#e2e8f0;" vertex="1" parent="1">
          <mxGeometry x="2330" y="1290" width="680" height="310" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
