            <mxPoint x="390" y="1653" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="legend-edge-flow-text" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;connection, client → server&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=10.5;fontColor=#e2e8f0;" vertex="1" parent="1">
          <mxGeometry x="402" y="1642" width="228" height="22" as="geometry" />
        </mxCell>
        <mxCell id="legend-edge-async" value="" style="edgeStyle=none;html=1;strokeColor=#a78bfa;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=6;dashed=1;dashPattern=6 4;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="350" y="1679" as="sourcePoint" />
            <mxPoint x="390" y="1679" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="legend-edge-async-text" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;background sync&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=10.5;fontColor=#e2e8f0;" vertex="1" parent="1">
          <mxGeometry x="402" y="1668" width="228" height="22" as="geometry" />
        </mxCell>
        <mxCell id="card-legend-notes" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;Large dashed frame: infra perimeter · small: functional group&lt;br&gt;&lt;font color=&quot;#fb923c&quot;&gt;&lt;b&gt;⚠ Gx&lt;/b&gt;&lt;/font&gt;: docs and code disagree, see &quot;Gaps&quot;&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=10.5;fontColor=#94a3b8;" vertex="1" parent="1">
          <mxGeometry x="60" y="1930" width="560" height="40" as="geometry" />
        </mxCell>
        <mxCell id="card-data-plane" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;&lt;font color=&quot;#22d3ee&quot;&gt;●&lt;/font&gt;&amp;nbsp;&lt;b&gt;&lt;font color=&quot;#f8fafc&quot; style=&quot;font-size:13px&quot;&gt;Request path · data plane&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;div style=&quot;line-height:1.6&quot;&gt;• A player joins and the server loads their progression.&lt;br&gt;&lt;span style=&quot;background-color:#f8fafc;color:#020617;border-radius:3px;padding:0px 4px;font-weight:bold;&quot;&gt;1&lt;/span&gt; The Minecraft client connects to arffornia.com:25565, an A record on the home IP (DNS-only).&lt;br&gt;&lt;span style=&quot;background-color:#f8fafc;color:#020617;border-radius:3px;padding:0px 4px;font-weight:bold;&quot;&gt;2&lt;/span&gt; The router forwards to the Velocity LoadBalancer VIP announced by MetalLB.&lt;br&gt;&lt;span style=&quot;background-color:#f8fafc;color:#020617;border-radius:3px;padding:0px 4px;font-weight:bold;&quot;&gt;3&lt;/span&gt; Velocity checks the Mojang session, then forwards the player to lobby = arcane:25565 with modern forwarding.&lt;br&gt;&lt;span style=&quot;background-color:#f8fafc;color:#020617;border-radius:3px;padding:0px 4px;font-weight:bold;&quot;&gt;4&lt;/span&gt; The Arffornia mod calls https://arffornia.com/api (ensure-exists, stages/player): out through the router and back to Envoy.&lt;br&gt;&lt;span style=&quot;background-color:#f8fafc;color:#020617;border-radius:3px;padding:0px 4px;font-weight:bold;&quot;&gt;5&lt;/span&gt; Envoy matches the HTTPRoute arffornia.com and proxies to the website Service.&lt;br&gt;&lt;span style=&quot;background-color:#f8fafc;color:#020617;border-radius:3px;padding:0px 4px;font-weight:bold;&quot;&gt;6&lt;/span&gt; Laravel reads and writes the arffornia database.&lt;br&gt;• Votes: vote site → router :8192 → NuVotifier on Velocity → POST /vote/nuvotifier (view vote-and-reward).&lt;/div&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#0b1222;strokeColor=#1e293b;align=left;verticalAlign=top;spacingLeft=20;spacingTop=14;spacingRight=16;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=11;fontColor=#e2e8f0;" vertex="1" parent="1">
          <mxGeometry x="670" y="1590" width="820" height="390" as="geometry" />
        </mxCell>
        <mxCell id="card-control-plane" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;&lt;font color=&quot;#a78bfa&quot;&gt;●&lt;/font&gt;&amp;nbsp;&lt;b&gt;&lt;font color=&quot;#f8fafc&quot; style=&quot;font-size:13px&quot;&gt;Background · control plane&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;div style=&quot;line-height:1.6&quot;&gt;&lt;span style=&quot;border:1px solid #f8fafc;color:#f8fafc;border-radius:3px;padding:0px 3px;font-weight:bold;&quot;&gt;A&lt;/span&gt; vault-secrets-operator reads kvv2 every 60 s with one Kubernetes role.&lt;br&gt;&lt;span style=&quot;border:1px solid #f8fafc;color:#f8fafc;border-radius:3px;padding:0px 3px;font-weight:bold;&quot;&gt;B&lt;/span&gt; It writes the Secrets of each VaultSecret (6 in arcane, 5 website, 3 proxy).&lt;br&gt;&lt;span style=&quot;border:1px solid #f8fafc;color:#f8fafc;border-radius:3px;padding:0px 3px;font-weight:bold;&quot;&gt;C&lt;/span&gt; &lt;span style=&quot;border:1px solid #f8fafc;color:#f8fafc;border-radius:3px;padding:0px 3px;font-weight:bold;&quot;&gt;D&lt;/span&gt; Argo CD pulls infra@HEAD and applies k8s/apps/arffornia/** with prune and selfHeal.&lt;br&gt;&lt;span style=&quot;border:1px solid #f8fafc;color:#f8fafc;border-radius:3px;padding:0px 3px;font-weight:bold;&quot;&gt;E&lt;/span&gt; Prometheus scrapes the server&amp;#39;s metrics port. &lt;span style=&quot;border:1px solid #f8fafc;color:#f8fafc;border-radius:3px;padding:0px 3px;font-weight:bold;&quot;&gt;F&lt;/span&gt; &lt;span style=&quot;border:1px solid #f8fafc;color:#f8fafc;border-radius:3px;padding:0px 3px;font-weight:bold;&quot;&gt;G&lt;/span&gt; app=minecraft alerts go to the Discord webhook_arffornia.&lt;br&gt;&lt;span style=&quot;border:1px solid #f8fafc;color:#f8fafc;border-radius:3px;padding:0px 3px;font-weight:bold;&quot;&gt;H&lt;/span&gt; &lt;span style=&quot;border:1px solid #f8fafc;color:#f8fafc;border-radius:3px;padding:0px 3px;font-weight:bold;&quot;&gt;I&lt;/span&gt; The mc-backup sidecar pauses saves over RCON and writes a daily tar.gz to the NAS, kept 14 days.&lt;br&gt;&lt;span style=&quot;border:1px solid #f8fafc;color:#f8fafc;border-radius:3px;padding:0px 3px;font-weight:bold;&quot;&gt;J&lt;/span&gt; Postgres ships WAL-G backups to in-cluster Garage, kept 90.&lt;br&gt;• MetalLB (L2) announces the LoadBalancer VIPs of Velocity and of Envoy (192.168.1.84).&lt;/div&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#0b1222;strokeColor=#1e293b;align=left;verticalAlign=top;spacingLeft=20;spacingTop=14;spacingRight=16;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=11;fontColor=#e2e8f0;" vertex="1" parent="1">
          <mxGeometry x="1520" y="1590" width="720" height="390" as="geometry" />
        </mxCell>
        <mxCell id="card-gaps" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;&lt;font color=&quot;#fb923c&quot;&gt;●&lt;/font&gt;&amp;nbsp;&lt;b&gt;&lt;font color=&quot;#f8fafc&quot; style=&quot;font-size:13px&quot;&gt;Gaps and risks found in code&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;div style=&quot;line-height:1.6&quot;&gt;&lt;b&gt;&lt;font color=&quot;#fb923c&quot;&gt;G1&lt;/font&gt;&lt;/b&gt; &lt;b&gt;&lt;font color=&quot;#f8fafc&quot;&gt;No Cloudflare for the site.&lt;/font&gt;&lt;/b&gt; Apex A record proxied = false; only subdomains are proxied.&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#fb923c&quot;&gt;G2&lt;/font&gt;&lt;/b&gt; &lt;b&gt;&lt;font color=&quot;#f8fafc&quot;&gt;Server writes the website DB.&lt;/font&gt;&lt;/b&gt; JDBC to db arffornia, runs pending_rewards.commands as console commands.&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#fb923c&quot;&gt;G3&lt;/font&gt;&lt;/b&gt; &lt;b&gt;&lt;font color=&quot;#f8fafc&quot;&gt;API hairpin.&lt;/font&gt;&lt;/b&gt; Server and proxy call the public hostname from inside the cluster.&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#fb923c&quot;&gt;G4&lt;/font&gt;&lt;/b&gt; &lt;b&gt;&lt;font color=&quot;#f8fafc&quot;&gt;One Vault identity.&lt;/font&gt;&lt;/b&gt; VSO&amp;#39;s single SA is bound to every role; VSO reaches Vault through Cloudflare.&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#fb923c&quot;&gt;G5&lt;/font&gt;&lt;/b&gt; &lt;b&gt;&lt;font color=&quot;#f8fafc&quot;&gt;No NetworkPolicy.&lt;/font&gt;&lt;/b&gt; RCON, game port (online-mode=false), metrics and BlueMap live open to every pod.&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#fb923c&quot;&gt;G6&lt;/font&gt;&lt;/b&gt; &lt;b&gt;&lt;font color=&quot;#f8fafc&quot;&gt;Alerting.&lt;/font&gt;&lt;/b&gt; 5 s scrape; CriticalServiceDown watches jobs that are never scraped.&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#fb923c&quot;&gt;G12&lt;/font&gt;&lt;/b&gt; &lt;b&gt;&lt;font color=&quot;#f8fafc&quot;&gt;Committed credentials.&lt;/font&gt;&lt;/b&gt; Proxy plugin ships its nuvotifier_service client secret in git.&lt;/div&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#0b1222;strokeColor=#1e293b;align=left;verticalAlign=top;spacingLeft=20;spacingTop=14;spacingRight=16;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=11;fontColor=#e2e8f0;" vertex="1" parent="1">
          <mxGeometry x="2270" y="1590" width="870" height="390" as="geometry" />
        </mxCell>
