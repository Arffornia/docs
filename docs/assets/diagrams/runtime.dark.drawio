        </mxCell>
        <mxCell id="n-cloudflare" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;Only proxied records cross Cloudflare: map, www, vault, argocd… The apex &lt;b&gt;&lt;font color=&quot;#f8fafc&quot;&gt;arffornia.com is DNS-only&lt;/font&gt;&lt;/b&gt; and hits dc_ip directly.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=10;fontColor=#94a3b8;" vertex="1" parent="1">
